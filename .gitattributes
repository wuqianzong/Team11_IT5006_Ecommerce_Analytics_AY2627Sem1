# Auto detect text files and perform LF normalization
* text=auto

# ML base/split artifacts carry canonical-LF content hashes (feature_contract.md §2):
# force LF in the working tree so a clean checkout reproduces the hashed bytes.
data/business/ml/*.csv text eol=lf
data/business/ml/*.json text eol=lf

# Preprocessed transactional inputs are hashed LF-normalized into the manifest;
# force LF on checkout so the working tree matches the hashed bytes on every OS.
data/preprocessed/*.csv text eol=lf

artifacts/metrics/**/*.csv text eol=lf
artifacts/metrics/**/*.json text eol=lf
*.ipynb text eol=lf
*.joblib binary
*.gz binary
data/reference/geography/* -text

{
  "task": "classification",
  "rules": [
    {
      "rule": "missing column",
      "level": "error",
      "source": "bundle schema.json (numeric, categorical) and the scope columns"
    },
    {
      "rule": "unknown state",
      "level": "error",
      "source": "Brazil's 27 state codes"
    },
    {
      "rule": "type",
      "level": "error",
      "source": "numeric features in schema.json"
    },
    {
      "rule": "impossible distance",
      "level": "error",
      "source": "0 to 5,000 km"
    },
    {
      "rule": "no items",
      "level": "error",
      "source": "n_items >= 1 (A's s10 10.5)"
    },
    {
      "rule": "missing installments",
      "level": "error",
      "source": "A's s10 10.5"
    },
    {
      "rule": "negative value",
      "level": "error",
      "source": "numeric features whose training minimum is >= 0 (drift_profile.json)"
    },
    {
      "rule": "missing value",
      "level": "warning",
      "source": "the bundle imputes the training median"
    },
    {
      "rule": "unseen category",
      "level": "warning",
      "source": "levels of the bundle's one-hot encoder (ignored when unseen)"
    },
    {
      "rule": "out of profile",
      "level": "warning",
      "source": "drift_profile.json; off until the team sets the SD limit (B10.6)"
    }
  ],
  "cases": [
    {
      "case": "valid in-scope order",
      "change": {},
      "expected": "scored (B frozen)",
      "status": "scored",
      "model": "B frozen",
      "rules": [],
      "passed": true
    },
    {
      "case": "valid out-of-scope order",
      "change": {},
      "expected": "scored (A frozen)",
      "status": "scored",
      "model": "A frozen",
      "rules": [],
      "passed": true
    },
    {
      "case": "unknown customer state",

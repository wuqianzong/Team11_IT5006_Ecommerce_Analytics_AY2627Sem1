# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Operating System files
.DS_Store
Thumbs.db

# IDE & Editor settings
.vscode/
.idea/

# Temporary & archive files
archive/
*.tmp
*.log

# Internal team review material is shared separately, not published.
*.md
/docs/
/data/business/ml/*.pdf
/src/reporting/*
!/src/reporting/__init__.py
!/src/reporting/charts.py
/src/common/recover_artifacts.py
/src/common/tests/
/src/models/rebuild_intermediates.py

# Publish only canonical experiment outputs, not internal review/replay copies.
/artifacts/*
!/artifacts/metrics/
!/artifacts/models/
!/artifacts/report/
!/artifacts/transport_manifest.json
/artifacts/metrics/*
!/artifacts/metrics/stage3-baseline-v1/
!/artifacts/metrics/stage4-selection-v1/
!/artifacts/metrics/stage5-tutorial8-v1/
!/artifacts/metrics/stage5-final-v1/
!/artifacts/metrics/stage5-scoring-demo-v1/
!/artifacts/metrics/stage5_holdout_access.json
!/artifacts/metrics/stage5_holdout_reproduction.json
!/artifacts/metrics/stage5_tutorial8_internal_verification.json
/artifacts/metrics/stage4-selection-v1/candidate_oof_predictions.csv
/artifacts/metrics/stage5-tutorial8-v1/oof_curve_coordinates.csv
/artifacts/models/*
!/artifacts/models/regression/
!/artifacts/models/classification/
/artifacts/models/regression/*
!/artifacts/models/regression/stage5-final-v1/
/artifacts/models/classification/*
!/artifacts/models/classification/stage5-final-v1/

# Publish report-sized result charts, not report documents or private audit logs.
/artifacts/report/*
!/artifacts/report/stage6-v1/
